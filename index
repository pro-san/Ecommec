                          required
                          value={newReviewAuthor}
                          onChange={(e) => setNewReviewAuthor(e.target.value)}
                          className="flex-1 text-xs px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg focus:outline-none"
                        />
                        <select
                          value={newReviewRating}
                          onChange={(e) => setNewReviewRating(Number(e.target.value))}
                          className="text-xs px-2 py-1.5 bg-white border border-slate-200 rounded-lg focus:outline-none font-semibold text-amber-500"
                        >
                          <option value="5">5 ★</option>
                          <option value="4">4 ★</option>
                          <option value="3">3 ★</option>
                          <option value="2">2 ★</option>
                          <option value="1">1 ★</option>
                        </select>
                      </div>
                      <div className="flex gap-2">
                        <input
                          type="text"
                          placeholder="Write feedback..."
                          required
                          value={newReviewComment}
                          onChange={(e) => setNewReviewComment(e.target.value)}
                          className="flex-1 text-xs px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg focus:outline-none"
                        />
                        <button type="submit" className="px-3 py-1.5 bg-slate-900 text-white rounded-lg text-xs font-semibold hover:bg-slate-800">
                          <Send className="w-3 h-3" />
                        </button>
                      </div>
                    </form>
                  </div>
                </div>

                {/* Modal Footer Controls */}
                <div className="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
                  <div>
                    <span className="text-2xl font-black text-slate-900">${(selectedProduct.price * modalQuantity).toFixed(2)}</span>
                    {selectedProduct.originalPrice && (
                      <span className="text-sm text-slate-400 line-through ml-2">
                        ${(selectedProduct.originalPrice * modalQuantity).toFixed(2)}
                      </span>
                    )}
                  </div>

                  <button
                    onClick={() => {
                      addToCart(selectedProduct, modalQuantity, modalSelectedColor, modalSelectedSize);
                      setSelectedProduct(null);
                    }}
                    disabled={!selectedProduct.inStock}
                    className="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl font-bold text-sm shadow-lg shadow-indigo-100 flex items-center gap-2 active:scale-95 transition"
                  >
                    <ShoppingCart className="w-4 h-4" /> Add to Cart
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Multistep Checkout Modal */}
      {isCheckoutOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 overflow-y-auto">
          <div className="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative my-8">
            <button
              onClick={() => {
                setIsCheckoutOpen(false);
                setCheckoutStep(1);
              }}
              className="absolute top-5 right-5 text-slate-400 hover:text-slate-600"
            >
              <X className="w-5 h-5" />
            </button>

            {/* Stepper Header */}
            {checkoutStep < 3 && (
              <div className="mb-6">
                <div className="flex items-center justify-between mb-2">
                  <span className={`text-xs font-bold uppercase tracking-wider ${checkoutStep >= 1 ? "text-indigo-600" : "text-slate-400"}`}>
                    1. Shipping
                  </span>
                  <span className="text-slate-300">———</span>
                  <span className={`text-xs font-bold uppercase tracking-wider ${checkoutStep >= 2 ? "text-indigo-600" : "text-slate-400"}`}>
                    2. Payment
                  </span>
                </div>
                <h3 className="text-xl font-black text-slate-900">
                  {checkoutStep === 1 ? "Shipping Details" : "Select Payment Method"}
                </h3>
              </div>
            )}

            {/* Step 1: Shipping Address Form */}
            {checkoutStep === 1 && (
              <form
                onSubmit={(e) => {
                  e.preventDefault();
                  setCheckoutStep(2);
                }}
                className="space-y-3.5 text-xs font-semibold text-slate-700"
              >
                <div>
                  <label className="block mb-1">Full Name</label>
                  <input
                    required
                    type="text"
                    value={shippingInfo.fullName}
                    onChange={(e) => setShippingInfo({ ...shippingInfo, fullName: e.target.value })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                  />
                </div>

                <div>
                  <label className="block mb-1">Email Address</label>
                  <input
                    required
                    type="email"
                    value={shippingInfo.email}
                    onChange={(e) => setShippingInfo({ ...shippingInfo, email: e.target.value })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                  />
                </div>

                <div>
                  <label className="block mb-1">Street Address</label>
                  <input
                    required
                    type="text"
                    value={shippingInfo.address}
                    onChange={(e) => setShippingInfo({ ...shippingInfo, address: e.target.value })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                  />
                </div>

                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block mb-1">City</label>
                    <input
                      required
                      type="text"
                      value={shippingInfo.city}
                      onChange={(e) => setShippingInfo({ ...shippingInfo, city: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                    />
                  </div>
                  <div>
                    <label className="block mb-1">Postal Code</label>
                    <input
                      required
                      type="text"
                      value={shippingInfo.postalCode}
                      onChange={(e) => setShippingInfo({ ...shippingInfo, postalCode: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                    />
                  </div>
                </div>

                <div className="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <div className="text-slate-500 text-xs font-normal">
                    Total: <strong className="text-slate-900">${cartTotal.toFixed(2)}</strong>
                  </div>
                  <button
                    type="submit"
                    className="px-6 py-3 bg-slate-900 hover:bg-indigo-600 text-white font-bold rounded-xl text-sm flex items-center gap-2 transition"
                  >
                    Continue to Payment <ArrowRight className="w-4 h-4" />
                  </button>
                </div>
              </form>
            )}

            {/* Step 2: Payment Details */}
            {checkoutStep === 2 && (
              <form onSubmit={handlePlaceOrder} className="space-y-4 text-xs font-semibold text-slate-700">
                {/* Method selector */}
                <div className="grid grid-cols-3 gap-2">
                  <button
                    type="button"
                    onClick={() => setPaymentMethod("card")}
                    className={`p-3 rounded-xl border text-center transition ${
                      paymentMethod === "card"
                        ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-bold"
                        : "border-slate-200 text-slate-600 hover:bg-slate-50"
                    }`}
                  >
                    <CreditCard className="w-5 h-5 mx-auto mb-1" /> Card
                  </button>
                  <button
                    type="button"
                    onClick={() => setPaymentMethod("apple")}
                    className={`p-3 rounded-xl border text-center transition ${
                      paymentMethod === "apple"
                        ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-bold"
                        : "border-slate-200 text-slate-600 hover:bg-slate-50"
                    }`}
                  >
                    <span className="block text-base mb-0.5"></span> Apple Pay
                  </button>
                  <button
                    type="button"
                    onClick={() => setPaymentMethod("paypal")}
                    className={`p-3 rounded-xl border text-center transition ${
                      paymentMethod === "paypal"
                        ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-bold"
                        : "border-slate-200 text-slate-600 hover:bg-slate-50"
                    }`}
                  >
                    <span className="block text-sm font-black mb-1">P</span> PayPal
                  </button>
                </div>

                {paymentMethod === "card" ? (
                  <div className="space-y-3">
                    <div>
                      <label className="block mb-1">Card Number</label>
                      <input
                        required
                        type="text"
                        value={paymentInfo.cardNumber}
                        onChange={(e) => setPaymentInfo({ ...paymentInfo, cardNumber: e.target.value })}
                        className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                      />
                    </div>
                    <div className="grid grid-cols-2 gap-3">
                      <div>
                        <label className="block mb-1">Expiry Date</label>
                        <input
                          required
                          type="text"
                          value={paymentInfo.expiry}
                          onChange={(e) => setPaymentInfo({ ...paymentInfo, expiry: e.target.value })}
                          className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                        />
                      </div>
                      <div>
                        <label className="block mb-1">Security Code (CVV)</label>
                        <input
                          required
                          type="text"
                          value={paymentInfo.cvv}
                          onChange={(e) => setPaymentInfo({ ...paymentInfo, cvv: e.target.value })}
                          className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-normal focus:outline-none focus:ring-2 focus:ring-indigo-100"
                        />
                      </div>
                    </div>
                  </div>
                ) : (
                  <div className="p-4 bg-slate-50 border border-slate-200 rounded-2xl text-center text-slate-600">
                    <p className="font-semibold text-sm">
                      {paymentMethod === 'apple' ? 'Apple Pay ready' : 'PayPal account linked'}
                    </p>
                    <p className="text-xs text-slate-400 mt-1">One-click simulated authorization</p>
                  </div>
                )}

                <div className="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <button
                    type="button"
                    onClick={() => setCheckoutStep(1)}
                    className="text-xs font-bold text-slate-500 hover:text-slate-800 flex items-center gap-1"
                  >
                    <ArrowLeft className="w-3.5 h-3.5" /> Back
                  </button>

                  <button
                    type="submit"
                    disabled={isProcessingOrder}
                    className="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm flex items-center gap-2 shadow-lg shadow-indigo-100 active:scale-95 transition"
                  >
                    {isProcessingOrder ? (
                      <>
                        <RefreshCw className="w-4 h-4 animate-spin" /> Authorizing...
                      </>
                    ) : (
                      <>
                        <CheckCircle2 className="w-4 h-4" /> Pay ${cartTotal.toFixed(2)}
                      </>
                    )}
                  </button>
                </div>
              </form>
            )}

            {/* Step 3: Order Confirmation */}
            {checkoutStep === 3 && completedOrder && (
              <div className="text-center py-4 space-y-4">
                <div className="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-10 h-10" />
                </div>
                <h3 className="text-2xl font-black text-slate-900">Order Confirmed!</h3>
                <p className="text-xs text-slate-500 max-w-xs mx-auto">
                  Your order has been authorized and dispatched to fulfillment. A receipt has been dispatched to <strong className="text-slate-700">{completedOrder.shippingInfo.email}</strong>.
                </p>

                <div className="p-4 bg-slate-50 rounded-2xl text-left text-xs space-y-1.5 text-slate-600 border border-slate-100">
                  <div className="flex justify-between font-bold text-slate-900">
                    <span>Order Tracking:</span>
                    <span className="text-indigo-600">{completedOrder.id}</span>
                  </div>
                  <div className="flex justify-between">
                    <span>Shipping To:</span>
                    <span>{completedOrder.shippingInfo.fullName}</span>
                  </div>
                  <div className="flex justify-between">
                    <span>Address:</span>
                    <span className="truncate max-w-[200px]">{completedOrder.shippingInfo.address}, {completedOrder.shippingInfo.city}</span>
                  </div>
                  <div className="flex justify-between font-bold text-slate-900 pt-1 border-t border-slate-200">
                    <span>Total Paid:</span>
                    <span className="text-emerald-600 font-black">${completedOrder.total.toFixed(2)}</span>
                  </div>
                </div>

                <div className="flex gap-2">
                  <button
                    onClick={() => {
                      setIsCheckoutOpen(false);
                      setIsOrdersOpen(true);
                    }}
                    className="flex-1 py-3 bg-white border border-slate-200 text-slate-800 rounded-xl font-bold text-xs hover:bg-slate-50"
                  >
                    View in Orders
                  </button>
                  <button
                    onClick={() => {
                      setIsCheckoutOpen(false);
                      setCheckoutStep(1);
                    }}
                    className="flex-1 py-3 bg-slate-900 text-white rounded-xl font-bold text-xs hover:bg-slate-800"
                  >
                    Continue Shopping
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="bg-slate-900 text-slate-400 text-xs py-12 border-t border-slate-800 mt-16">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
          <div className="space-y-3">
            <span className="text-xl font-black text-white">LUMEN</span>
            <p className="leading-relaxed">Crafting high-fidelity lifestyle audio, tech apparel and everyday modern carry essentials.</p>
          </div>
          <div>
            <h5 className="font-bold text-white mb-3 uppercase tracking-wider text-[11px]">Shop Categories</h5>
            <ul className="space-y-2">
              <li onClick={() => setActiveCategory("Electronics")} className="hover:text-white cursor-pointer">Electronics</li>
              <li onClick={() => setActiveCategory("Accessories")} className="hover:text-white cursor-pointer">Accessories</li>
              <li onClick={() => setActiveCategory("Footwear")} className="hover:text-white cursor-pointer">Footwear</li>
              <li onClick={() => setActiveCategory("Lifestyle")} className="hover:text-white cursor-pointer">Lifestyle</li>
            </ul>
          </div>
          <div>
            <h5 className="font-bold text-white mb-3 uppercase tracking-wider text-[11px]">Help & Service</h5>
            <ul className="space-y-2">
              <li onClick={() => setIsOrdersOpen(true)} className="hover:text-white cursor-pointer">Order Status</li>
              <li className="hover:text-white cursor-pointer">Shipping & Returns</li>
              <li className="hover:text-white cursor-pointer">Warranty Protection</li>
              <li className="hover:text-white cursor-pointer">Privacy Policy</li>
            </ul>
          </div>
          <div>
            <h5 className="font-bold text-white mb-3 uppercase tracking-wider text-[11px]">Newsletter</h5>
            <p className="mb-2">Subscribe to receive discounts and product drop alerts.</p>
            <div className="flex">
              <input 
                type="email" 
                placeholder="your.email@example.com" 
                className="bg-slate-800 text-white px-3 py-2 rounded-l-xl text-xs w-full focus:outline-none" 
              />
              <button 
                onClick={() => showToast("Subscribed to the newsletter!")}
                className="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-r-xl font-bold"
              >
                Join
              </button>
            </div>
          </div>
        </div>
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-6 border-t border-slate-800 text-center text-slate-500">
          © {new Date().getFullYear()} LUMEN Storefront. All features fully interactive.
        </div>
      </footer>
    </div>
  );
}
