const CATEGORIES = ["All", "Electronics", "Accessories", "Footwear", "Lifestyle"];

export default function App() {
  // Products state (allows reviews to be dynamically added)
  const [products, setProducts] = useState(() => {
    const saved = localStorage.getItem("lumen_products");
    return saved ? JSON.parse(saved) : INITIAL_PRODUCTS;
  });

  // Navigation & View Filters
  const [activeCategory, setActiveCategory] = useState("All");
  const [searchQuery, setSearchQuery] = useState("");
  const [sortBy, setSortBy] = useState("featured");
  const [maxPrice, setMaxPrice] = useState(250);
  
  // Persistent Cart, Wishlist, Orders
  const [cart, setCart] = useState(() => {
    const saved = localStorage.getItem("lumen_cart");
    return saved ? JSON.parse(saved) : [];
  });

  const [wishlist, setWishlist] = useState(() => {
    const saved = localStorage.getItem("lumen_wishlist");
    return saved ? JSON.parse(saved) : [];
  });

  const [orders, setOrders] = useState(() => {
    const saved = localStorage.getItem("lumen_orders");
    return saved ? JSON.parse(saved) : [];
  });

  // Modals & Drawers
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [isWishlistOpen, setIsWishlistOpen] = useState(false);
  const [isOrdersOpen, setIsOrdersOpen] = useState(false);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [modalSelectedColor, setModalSelectedColor] = useState(0);
  const [modalSelectedSize, setModalSelectedSize] = useState(0);
  const [modalQuantity, setModalQuantity] = useState(1);

  // New review state in modal
  const [newReviewAuthor, setNewReviewAuthor] = useState("");
  const [newReviewComment, setNewReviewComment] = useState("");
  const [newReviewRating, setNewReviewRating] = useState(5);

  // Checkout Modal & Flow
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);
  const [checkoutStep, setCheckoutStep] = useState(1); // 1: Shipping, 2: Payment, 3: Completed
  const [paymentMethod, setPaymentMethod] = useState("card");
  const [shippingInfo, setShippingInfo] = useState({
    fullName: "Alex Parker",
    email: "alex.parker@example.com",
    address: "742 Evergreen Terrace",
    city: "Springfield",
    postalCode: "97477",
    country: "United States"
  });
  const [paymentInfo, setPaymentInfo] = useState({
    cardNumber: "4242 •••• •••• 4242",
    expiry: "12/28",
    cvv: "789"
  });
  const [completedOrder, setCompletedOrder] = useState(null);
  const [isProcessingOrder, setIsProcessingOrder] = useState(false);

  // Promo code & toast
  const [couponCode, setCouponCode] = useState("");
  const [discountPercent, setDiscountPercent] = useState(0);
  const [couponError, setCouponError] = useState("");
  const [toastMessage, setToastMessage] = useState(null);

  // Sync to LocalStorage
  useEffect(() => {
    localStorage.setItem("lumen_cart", JSON.stringify(cart));
  }, [cart]);

  useEffect(() => {
    localStorage.setItem("lumen_wishlist", JSON.stringify(wishlist));
  }, [wishlist]);

  useEffect(() => {
    localStorage.setItem("lumen_orders", JSON.stringify(orders));
  }, [orders]);

  useEffect(() => {
    localStorage.setItem("lumen_products", JSON.stringify(products));
  }, [products]);

  // Trigger feedback toast
  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => {
      setToastMessage(null);
    }, 2800);
  };

  // Add to Cart with optional specific attributes
  const addToCart = (product, quantity = 1, colorIdx = 0, sizeIdx = 0) => {
    if (!product.inStock) {
      showToast("This item is currently out of stock.");
      return;
    }

    const selectedColorName = product.colorNames ? product.colorNames[colorIdx] : null;
    const selectedSizeName = product.sizes ? product.sizes[sizeIdx] : null;
    const itemKey = `${product.id}-${selectedColorName}-${selectedSizeName}`;

    setCart((prev) => {
      const existing = prev.find((item) => item.cartKey === itemKey);
      if (existing) {
        return prev.map((item) =>
          item.cartKey === itemKey ? { ...item, quantity: item.quantity + quantity } : item
        );
      }
      return [
        ...prev,
        {
          ...product,
          cartKey: itemKey,
          selectedColor: selectedColorName,
          selectedSize: selectedSizeName,
          quantity
        }
      ];
    });
    showToast(`Added ${quantity}x "${product.name}" to cart!`);
  };

  const updateQuantity = (cartKey, delta) => {
    setCart((prev) =>
      prev
        .map((item) => {
          if (item.cartKey === cartKey) {
            const newQty = item.quantity + delta;
            return newQty > 0 ? { ...item, quantity: newQty } : null;
          }
          return item;
        })
        .filter(Boolean)
    );
  };

  const removeFromCart = (cartKey) => {
    setCart((prev) => prev.filter((item) => item.cartKey !== cartKey));
    showToast("Item removed from cart");
  };

  const clearCart = () => {
    setCart([]);
    showToast("Cart cleared");
  };

  // Wishlist toggle
  const toggleWishlist = (product) => {
    setWishlist((prev) => {
      const exists = prev.some((p) => p.id === product.id);
      if (exists) {
        showToast(`Removed from favorites`);
        return prev.filter((p) => p.id !== product.id);
      } else {
        showToast(`Saved to favorites!`);
        return [...prev, product];
      }
    });
  };

  // Promo Code Validation
  const applyCoupon = (e) => {
    e.preventDefault();
    const cleanCode = couponCode.trim().toUpperCase();
    if (cleanCode === "SAVE20") {
      setDiscountPercent(0.20);
      setCouponError("");
      showToast("🎉 20% discount applied!");
    } else if (cleanCode === "WELCOME10") {
      setDiscountPercent(0.10);
      setCouponError("");
      showToast("🎉 10% discount applied!");
    } else {
      setCouponError("Invalid promo code. Try 'SAVE20' or 'WELCOME10'");
    }
  };

  // Review submission
  const handleAddReview = (e) => {
    e.preventDefault();
    if (!newReviewAuthor.trim() || !newReviewComment.trim()) return;

    const newRev = {
      id: Date.now(),
      author: newReviewAuthor.trim(),
      rating: newReviewRating,
      date: "Just now",
      comment: newReviewComment.trim()
    };

    setProducts((prev) =>
      prev.map((p) => {
        if (p.id === selectedProduct.id) {
          const updatedReviews = [newRev, ...(p.userReviews || [])];
          const newAvgRating = +(
            updatedReviews.reduce((sum, r) => sum + r.rating, 0) / updatedReviews.length
          ).toFixed(1);
          const updated = {
            ...p,
            userReviews: updatedReviews,
            reviewsCount: updatedReviews.length,
            rating: newAvgRating
          };
          setSelectedProduct(updated);
          return updated;
        }
        return p;
      })
    );

    setNewReviewAuthor("");
    setNewReviewComment("");
    setNewReviewRating(5);
    showToast("Review submitted successfully!");
  };

  // Order Placement
  const handlePlaceOrder = (e) => {
    e.preventDefault();
    setIsProcessingOrder(true);

    setTimeout(() => {
      const orderId = `LM-${Math.floor(100000 + Math.random() * 900000)}`;
      const orderData = {
        id: orderId,
        date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
        items: [...cart],
        subtotal: cartSubtotal,
        discount: discountAmount,
        shipping: shippingFee,
        total: cartTotal,
        shippingInfo: { ...shippingInfo },
        paymentMethod: paymentMethod === 'card' ? 'Credit Card' : paymentMethod === 'apple' ? 'Apple Pay' : 'PayPal',
        status: "Processing"
      };

      setOrders((prev) => [orderData, ...prev]);
      setCompletedOrder(orderData);
      setCart([]);
      setIsProcessingOrder(false);
      setCheckoutStep(3); // Step 3: Confirmation
      showToast("Order placed successfully!");
    }, 1200);
  };

  // Price & Cart Calculations
  const cartSubtotal = useMemo(() => {
    return cart.reduce((acc, item) => acc + item.price * item.quantity, 0);
  }, [cart]);

  const discountAmount = cartSubtotal * discountPercent;
  const shippingFee = cartSubtotal > 150 || cartSubtotal === 0 ? 0 : 9.99;
  const cartTotal = Math.max(0, cartSubtotal - discountAmount + shippingFee);
  const cartItemsCount = cart.reduce((acc, item) => acc + item.quantity, 0);

  // Filter & Sort Logic
  const filteredProducts = useMemo(() => {
    return products.filter((item) => {
      const matchesCategory = activeCategory === "All" || item.category === activeCategory;
      const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                            item.description.toLowerCase().includes(searchQuery.toLowerCase());
      const matchesPrice = item.price <= maxPrice;
      return matchesCategory && matchesSearch && matchesPrice;
    }).sort((a, b) => {
      if (sortBy === "price-low") return a.price - b.price;
      if (sortBy === "price-high") return b.price - a.price;
      if (sortBy === "rating") return b.rating - a.rating;
      return 0;
    });
  }, [products, activeCategory, searchQuery, maxPrice, sortBy]);

  // Open Product Modal helper
  const openProductModal = (product) => {
    setSelectedProduct(product);
    setModalSelectedColor(0);
    setModalSelectedSize(0);
    setModalQuantity(1);
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white">
